# === SarkariPath environment variables ===
# Is file ko copy karke ".env.local" banao aur real values daalo.
# Vercel pe deploy karte waqt yehi variables Vercel dashboard me bhi add karo.

# --- Google Sign-In (NextAuth) ---
# Google Cloud Console > APIs & Services > Credentials se banao (README me steps hain)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# NextAuth secret: terminal me `openssl rand -base64 32` chala kar generate karo
NEXTAUTH_SECRET=your-random-secret
# Local ke liye ye rakho; Vercel pe apna domain daalo (https://sarkaripath.onl)
NEXTAUTH_URL=http://localhost:3000

# --- Payment (Razorpay) ---
# Razorpay Dashboard > Settings > API Keys se banao
NEXT_PUBLIC_RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
