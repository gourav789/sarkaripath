# === SarkariPath environment variables ===
# Is file ko copy karke ".env.local" banao aur real values daalo (local dev ke liye).
# Cloudflare pe deploy karte waqt yehi as SECRETS set karo (README dekho).

# --- Razorpay (payment) ---
# Razorpay Dashboard > Settings > API Keys se banao.
# Test mode me "rzp_test_..." aur live mode me "rzp_live_..." milega.
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# --- Google Sign-In (NextAuth) — optional, baad me activate karo ---
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
NEXTAUTH_SECRET=your-random-secret
NEXTAUTH_URL=http://localhost:3000
