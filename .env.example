# === SarkariPath environment variables ===
# Is file ko copy karke ".env.local" banao aur real values daalo (local dev ke liye).
# Cloudflare pe deploy karte waqt yehi as SECRETS set karo (README dekho).

# --- Razorpay (payment) ---
# Razorpay Dashboard > Settings > API Keys se banao.
# Test mode me "rzp_test_..." aur live mode me "rzp_live_..." milega.
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# --- Google Sign-In (NextAuth / Auth.js v5) ---
AUTH_SECRET=your-random-secret
AUTH_GOOGLE_ID=your-google-client-id
AUTH_GOOGLE_SECRET=your-google-client-secret
AUTH_URL=http://localhost:3000

